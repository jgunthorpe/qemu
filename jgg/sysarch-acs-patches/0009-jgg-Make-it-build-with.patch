diff --git a/tools/scripts/build_drtm_uefi.sh b/tools/scripts/build_drtm_uefi.sh
index feed1d95760f95..a3a32ab51dc1f7 100644
--- a/tools/scripts/build_drtm_uefi.sh
+++ b/tools/scripts/build_drtm_uefi.sh
@@ -18,26 +18,50 @@
 #!/bin/bash
 
 WORK_DIR=${PWD}/workspace
-HOME_DIR=${PWD}
+SOURCE_DIR=${PWD}
+
+# edk2's CLANGDWARF toolchain expects this variable to name a directory
+# containing clang, ld.lld, llvm-ar, and llvm-objcopy.  Honour an explicit
+# setting first, then try the unversioned compiler and common Linux LLVM
+# installation directories.
+if [ -z "${CLANGDWARF_BIN:-}" ]
+then
+    CLANG_PATH=$(command -v clang 2>/dev/null)
+    if [ -z "${CLANG_PATH}" ]
+    then
+        CLANG_PATH=$(compgen -G '/usr/lib/llvm-*/bin/clang' | sort -V | tail -n 1)
+    fi
+
+    if [ -z "${CLANG_PATH}" ]
+    then
+        echo "Unable to find clang. Set CLANGDWARF_BIN to the LLVM bin directory."
+        return 1
+    fi
+
+    CLANGDWARF_BIN=$(dirname "$(readlink -f "${CLANG_PATH}")")
+fi
+
+export CLANGDWARF_BIN="${CLANGDWARF_BIN%/}/"
+for LLVM_TOOL in clang ld.lld llvm-ar llvm-objcopy
+do
+    if [ ! -x "${CLANGDWARF_BIN}${LLVM_TOOL}" ]
+    then
+        echo "Missing ${CLANGDWARF_BIN}${LLVM_TOOL}. Set CLANGDWARF_BIN to a complete LLVM bin directory."
+        return 1
+    fi
+done
 
 if [ ! -d workspace ]
 then
     mkdir workspace
 fi
 cd ${WORK_DIR}
-if [ ! -d arm-gnu-toolchain-14.3.rel1-x86_64-aarch64-none-linux-gnu ]
-then
-    rm -f arm-gnu-toolchain-14.3.rel1-x86_64-aarch64-none-linux-gnu.tar.xz
-    wget https://developer.arm.com/-/media/Files/downloads/gnu/14.3.rel1/binrel/arm-gnu-toolchain-14.3.rel1-x86_64-aarch64-none-linux-gnu.tar.xz
-    tar -xf arm-gnu-toolchain-14.3.rel1-x86_64-aarch64-none-linux-gnu.tar.xz
-fi
-
 if [ ! -d output ]
 then
     mkdir output
 fi
 
-echo "Building DRTM ACS for UEFI"
+echo "Building DRTM ACS for UEFI with LLVM from ${CLANGDWARF_BIN}"
 if [ ! -d edk2 ]
 then
     git clone --recursive --branch edk2-stable202511 https://github.com/tianocore/edk2.git
@@ -47,17 +71,30 @@ cd ${WORK_DIR}/edk2
 make -C BaseTools
 
 rm -f ShellPkg/Application/sysarch-acs
-rm -rf Build/Shell/DEBUG_GCC/*
+rm -rf Build/Shell/DEBUG_CLANGDWARF/*
 
-ln -s ${HOME_DIR} ShellPkg/Application/sysarch-acs
-export GCC_AARCH64_PREFIX=${WORK_DIR}/arm-gnu-toolchain-14.3.rel1-x86_64-aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu-
+ln -s ${SOURCE_DIR} ShellPkg/Application/sysarch-acs
+export ACS_PATH=${SOURCE_DIR}
 export PACKAGES_PATH=${WORK_DIR}/edk2/edk2-libc
 
 source edksetup.sh
+git checkout ShellPkg/ShellPkg.dsc
 git apply ShellPkg/Application/sysarch-acs/patches/edk2_drtm.patch
-source ShellPkg/Application/sysarch-acs/tools/scripts/acsbuild.sh drtm
-cp Build/Shell/DEBUG_GCC/AARCH64/Drtm.efi ${WORK_DIR}/output
+if ! build -a AARCH64 -t CLANGDWARF -p ShellPkg/ShellPkg.dsc \
+    -m ShellPkg/Application/sysarch-acs/apps/uefi/Drtm.inf
+then
+    cd ${SOURCE_DIR}
+    echo "Failed to build Drtm.efi"
+    return 1
+fi
 
-cd ${HOME_DIR}
+if ! cp Build/Shell/DEBUG_CLANGDWARF/AARCH64/Drtm.efi ${WORK_DIR}/output
+then
+    cd ${SOURCE_DIR}
+    echo "Failed to copy Drtm.efi to ${WORK_DIR}/output"
+    return 1
+fi
+
+cd ${SOURCE_DIR}
 
 echo "Drtm EFI Application is available here : ${WORK_DIR}/output/Drtm.efi"
