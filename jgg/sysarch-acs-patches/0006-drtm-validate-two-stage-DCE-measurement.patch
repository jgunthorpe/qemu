-validate_zero_digest_event(const DRTM_EVENT_LOG_STATE *event_log,
-                           const DRTM_EVENT_LOG_ENTRY *entry, uint16_t hash_alg,
-                           const uint8_t *expected_digest, uint32_t expected_digest_size)
+static int32_t
+validate_dce_event(const DRTM_EVENT_LOG_STATE *event_log,
+                   const DRTM_EVENT_LOG_ENTRY *entry, const DCE_TEST_VECTOR *vector)
+{
+  TCG_EFI_SPECID_EVENT_ALGO_SIZE *algorithms;
+  const uint8_t *expected_digest;
+  uint8_t  *event_digest;
+  uint16_t digest_size;
+  uint16_t event_digest_size;
+  uint16_t event_hash_alg;
+  uint32_t index;
+
+  if (entry->event->digests.count != event_log->event_spec->number_of_algorithms)
+    return ACS_STATUS_FAIL;
+
+  algorithms = (TCG_EFI_SPECID_EVENT_ALGO_SIZE *)event_log->event_spec->digest_sizes;
+  for (index = 0; index < event_log->event_spec->number_of_algorithms; index++) {
+    expected_digest = get_bank_digest(vector, algorithms[index].algorithm_id, &digest_size);
+    if (expected_digest == NULL || digest_size != algorithms[index].digest_size)
+      return ACS_STATUS_FAIL;
+
+    if (val_drtm_event_log_get_digest(event_log, entry, algorithms[index].algorithm_id,
+                                      &event_digest, &event_digest_size) != ACS_STATUS_PASS ||
+        event_digest_size != digest_size ||
+        val_memory_compare(event_digest, (void *)expected_digest, digest_size))
+      return ACS_STATUS_FAIL;
+  }
+
+  if (entry->event_data_size != sizeof(event_hash_alg) + vector->dce_digest_size)
+    return ACS_STATUS_FAIL;
+
+  val_memcpy(&event_hash_alg, entry->event_data, sizeof(event_hash_alg));
+  if (event_hash_alg != vector->fw_hash_alg ||
+      val_memory_compare(entry->event_data + sizeof(event_hash_alg),
+                         (void *)vector->dce_digest, vector->dce_digest_size))
+    return ACS_STATUS_FAIL;
+
+  return ACS_STATUS_PASS;
+}
