+/**
+  @brief  Initialize a TCB hash table using the digest size for a TPM algorithm
+  @param  hash_table  Allocated TCB hash table
+  @param  revision    TCB hash table revision
+  @param  num_hashes  Number of entries to initialize
+  @param  hash_alg    TPM algorithm identifier
+
+  @return ACS_STATUS_PASS on success, ACS_STATUS_ERR for an unsupported algorithm.
+ **/
+uint32_t val_drtm_init_tcb_hash_table(DRTM_TCB_HASH_TABLE *hash_table,
+                                      uint16_t revision, uint16_t num_hashes,
+                                      uint16_t hash_alg)
+{
+    uint8_t *hash_entry;
+    uint32_t digest_size;
+    uint32_t hash;
+    uint32_t byte;
+
+    digest_size = val_drtm_get_digest_size(hash_alg);
+    if (!digest_size)
+        return ACS_STATUS_ERR;
+
+    hash_table->header.revision = revision;
+    hash_table->header.num_hashes = num_hashes;
+    hash_table->header.hash_algo = hash_alg;
+    hash_table->header.reserved = 0;
+
+    hash_entry = (uint8_t *)hash_table + sizeof(DRTM_TCB_HASH_TABLE_HDR);
+    for (hash = 0; hash < num_hashes; hash++) {
+        DRTM_TCB_HASHES *tcb_hash = (DRTM_TCB_HASHES *)hash_entry;
+
+        tcb_hash->hash_id = hash;
+        for (byte = 0; byte < digest_size; byte++)
+            tcb_hash->hash_val[byte] = 0;
+
+        hash_entry += sizeof(uint32_t) + digest_size;
+    }
+
+    return ACS_STATUS_PASS;
+}
